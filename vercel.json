{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-stale",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron-digest",
      "schedule": "0 13 * * 0"
    }
  ],
  "functions": {
    "api/study-import.js": {
      "maxDuration": 60
    }
  }
}
