{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron-stale",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-digest",
      "schedule": "0 8 * * 0"
    }
  ]
}
